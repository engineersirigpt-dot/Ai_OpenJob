OPENAI_API_KEY=sk-...
REALTIME_MODEL=gpt-realtime
VOICE=cedar
# Voice for Pornchai mode (falls back to VOICE when unset), e.g. ash
VOICE_PORNCHAI=ash
# Speaking rate for the realtime voice: 1.0 = normal, accepts 0.25–1.5
SPEECH_SPEED=1.25
SCORING_MODEL=gpt-4o-mini
# Model for the post-meeting minutes report (default gpt-5.5, falls back to gpt-4o)
SUMMARY_MODEL=gpt-5.5
# Model for post-meeting memory extraction (default gpt-5.4-mini → gpt-4o-mini)
MEMORY_MODEL=gpt-5.4-mini
# --- พรชัย two-tier brain ---
# Thinking model for pornchai answers (falls back down gpt-5.x → gpt-4o).
THINK_MODEL=gpt-5.5
# Reasoning effort for gpt-5.x thinking: low | medium | high ("minimal" is NOT
# accepted by gpt-5.5). Higher = smarter but slower.
THINK_EFFORT=low
# Answer length: low | medium | high — "low" is ~35% faster with the same
# analytical structure (spoken answers shouldn't be essays).
THINK_VERBOSITY=low
# Transcription ("ears"): gpt-4o-transcribe (default — best Thai in our tests)
# | gpt-4o-mini-transcribe (cheaper) | whisper-1
TRANSCRIBE_MODEL=gpt-transcribe
REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
# End-of-meeting pass over the recording: whole files.
# Plain transcription, NOT the diarizing model — the room's speech is kept as
# one running block, and this model accepts the vocabulary hint (the diarizing
# one refuses it), which is what spells CAR / Komori / Spot UV correctly.
TRANSCRIBE_FILE_MODEL=gpt-transcribe

# --- Transcript cross-check ---
# At the end of a meeting the recording's transcript and the live transcript
# are compared against each other, and this model decides the disagreements
# (numbers, names, print-shop terms). Falls back to gpt-4o.
RECONCILE_MODEL=gpt-5.5

# --- STT quality layer ---
# Deterministic domain dictionary (Spot UV, L640, ...) — on by default.
# Add/override terms per deployment in data/stt-dictionary.json (no rebuild).
STT_DICTIONARY_ENABLED=true
# Thai-only transcript scrub + foreign-sentence filter. Set false for
# non-Thai-primary meetings (generic mode).
STT_THAI_ONLY=true
# Confidence gate from logprobs: off | observe (log only, default) | enforce
STT_CONFIDENCE_MODE=observe
# Enforce thresholds — tune from observe-mode logs before enabling enforce
STT_CONF_GEO_MIN=0.45
STT_CONF_LOWRATIO_MAX=0.4

# Internal REPORT2 system (job list + WI meeting PDFs)
REPORT2_BASE_URL=http://192.168.5.40

# --- Microphone and the speech gate (client-side; applied at build time) ---
# Echo cancellation stops พรชัย's own voice coming back in through the
# speaker, so it stays on. Noise suppression stays off: the measured room
# floor was -62 dBFS, already quiet, and suppression costs consonants.
NEXT_PUBLIC_MIC_AEC=true
NEXT_PUBLIC_MIC_NS=false
NEXT_PUBLIC_MIC_AGC=true
# How much the app lifts the room itself. The browser's auto-gain above was
# asked for and measurably did nothing on the conference mic — two recordings
# days apart came back within 0.3 dB of each other, both near -42 dBFS, where
# speech wants about -23. 4 is +12 dB, with a limiter after it so peaks are
# held instead of clipped (6 measured 5 dB too hot). 1 turns the stage off.
NEXT_PUBLIC_MIC_GAIN=4
# Cut everything below this many Hz before the gain. A recording on 29 Oct had
# 92% of its energy under 300 Hz (air across the mic, room hum) with the floor
# 16 dB louder than the day before; speech lives from 300 Hz up, so 150 Hz
# takes the rumble and leaves the voices. 0 turns the filter off.
NEXT_PUBLIC_MIC_HPF=150
# Notch out mains hum at this frequency and twice it. The 29 Oct recording had
# a tone at 100 Hz (2x the 50 Hz mains) 22 dB above its surroundings — a
# ground loop through the charger/USB, not the room. The notch removes it
# completely (-1 dB) and is far too narrow to touch a voice. 0 turns it off.
NEXT_PUBLIC_MIC_NOTCH=100
# Every mic setting in this block can be overridden in the browser for a test,
# without a rebuild — in the console (F12):
#   localStorage.setItem("micAEC", "false"); location.reload();
#   localStorage.setItem("micGain", "8");    location.reload();
#   localStorage.clear();                    location.reload();   // back to .env
# Keys: micAEC micNS micAGC micGain micHighpass micNotch sttRmsStart sttRmsKeep
# How loud a frame must be to count as speech, in PRE-GAIN units — the units
# a measurement of a raw recording gives you. The code multiplies these by
# NEXT_PUBLIC_MIC_GAIN, so changing the gain cannot leave the gate below the
# amplified noise floor. Check the [stt-gate] line in the browser console
# during a real meeting before changing them: if the room is talking and
# "ผ่านเกณฑ์" stays near 0, the gate is above the room.
NEXT_PUBLIC_STT_RMS_START=0.004
NEXT_PUBLIC_STT_RMS_KEEP=0.0025

# --- Live transcript: streaming ---
# The live transcript streams the room to gpt-live-transcribe over a Realtime
# socket (words appear while they are said). Realtime-only: it answers 404 on
# the file endpoint, so the recorded pieces keep using TRANSCRIBE_FILE_MODEL.
# If the socket cannot be opened or drops, the browser falls back to cutting
# slices and POSTing them (TRANSCRIBE_MODEL) and keeps trying to reconnect.
# LIVE_TRANSCRIBE=off forces the slice path.
# LIVE_TRANSCRIBE=on
# LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe

# --- What the speech model is told ---
# A short Thai sentence saying what the audio is. It used to be the company's
# vocabulary list, which the model read back INSTEAD of the speech in 19 of 25
# slices of a real meeting; with no prompt at all, 14 of 25 came back in random
# other languages. The sentence keeps the output Thai and is removed exactly
# when echoed. Spelling of print terms is the dictionary's job.
#   STT_VOCAB="..."   replaces the sentence      STT_VOCAB=off   sends none
# STT_VOCAB=บทสนทนาในที่ประชุมของโรงพิมพ์ พูดภาษาไทย
# Which speech model. gpt-transcribe (July 2026) is the default on both the
# live slices and the recorded pieces: side by side with gpt-4o-transcribe on
# the room's own audio it echoed the prompt 0 times (vs 7 of 25 slices), wrote
# no foreign text, never looped (gpt-4o-transcribe's longest answer was one
# syllable 320 times), returned the same text on every run, and was 3x faster.
# TRANSCRIBE_MODEL=gpt-transcribe
# TRANSCRIBE_FILE_MODEL=gpt-transcribe
# How many times each recorded piece is transcribed, keeping the fullest
# result (1-4). Leave unset: 1 for gpt-transcribe (it is deterministic, a
# second try buys nothing), 2 for the gpt-4o family (a coin toss on hard
# audio — the same piece came back as 14, 303, 424 and 458 characters).
# TRANSCRIBE_FILE_SAMPLES=2

# --- Keeping the room's audio ---
# The recording is written to data/recordings/<id>/ so a meeting can be played
# back. Set false to go back to transcribing from memory and keeping nothing.
# A CAR investigation recorded here is people's words, verbatim, and anyone
# who can open the app can play it — keep the window short unless there is a
# reason not to. Old recordings are swept on every save.
KEEP_RECORDINGS=true
RECORDING_RETENTION_DAYS=90
