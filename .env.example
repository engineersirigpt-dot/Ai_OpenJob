OPENAI_API_KEY=sk-...
REALTIME_MODEL=gpt-realtime
VOICE=cedar
SCORING_MODEL=gpt-4o-mini
# Realtime transcription model: gpt-4o-mini-transcribe (default) | whisper-1
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- STT quality layer ---
# Deterministic domain dictionary (Spot UV, L640, ...) — on by default.
# Add/override terms per deployment in data/stt-dictionary.json (no rebuild).
STT_DICTIONARY_ENABLED=true
# Thai-only transcript scrub + foreign-sentence filter. Set false for
# non-Thai-primary meetings (generic mode).
STT_THAI_ONLY=true
# Confidence gate from logprobs: off | observe (log only, default) | enforce
STT_CONFIDENCE_MODE=observe
# Enforce thresholds — tune from observe-mode logs before enabling enforce
STT_CONF_GEO_MIN=0.45
STT_CONF_LOWRATIO_MAX=0.4

# Internal REPORT2 system (job list + WI meeting PDFs)
REPORT2_BASE_URL=http://192.168.5.40
